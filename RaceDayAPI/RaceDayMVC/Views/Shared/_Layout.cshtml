<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RaceDayMVC</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/RaceDayMVC.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        @{
            var userRole = Context.Session.GetString("Role");
            var isLoggedIn = Context.Session.GetInt32("UserID") != null;
        }

        <header>
            <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
                <div class="container">

                    <a class="navbar-brand fw-bold"
                       asp-controller="Home"
                       asp-action="Index">
                        RaceDay
                    </a>

                    <button class="navbar-toggler"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#raceDayNavbar"
                            aria-controls="raceDayNavbar"
                            aria-expanded="false"
                            aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <div class="collapse navbar-collapse"
                         id="raceDayNavbar">

                        <ul class="navbar-nav me-auto">

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Home"
                                   asp-action="Index">
                                    Home
                                </a>
                            </li>

                            @if (isLoggedIn && userRole == "Organiser")
                            {
                                <li class="nav-item">
                                    <a class="nav-link"
                                       asp-controller="Organiser"
                                       asp-action="Index">
                                        Dashboard
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link"
                                       asp-controller="Events"
                                       asp-action="Index">
                                        Events
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link"
                                       asp-controller="Categories"
                                       asp-action="Index">
                                        Categories
                                    </a>
                                </li>
                            }

                            @if (isLoggedIn && userRole == "Participant")
                            {
                                <li class="nav-item">
                                    <a class="nav-link"
                                       asp-controller="Events"
                                       asp-action="Index">
                                        Browse Events
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link"
                                       asp-controller="Participant"
                                       asp-action="MyEvents">
                                        My Events
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link"
                                       asp-controller="Participant"
                                       asp-action="MyResults">
                                        My Results
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link"
                                       asp-controller="Profile"
                                       asp-action="Index">
                                        Profile
                                    </a>
                                </li>
                            }

                        </ul>

                        <ul class="navbar-nav ms-auto">

                            @if (!isLoggedIn)
                            {
                                <li class="nav-item">
                                    <a class="nav-link"
                                       asp-controller="Account"
                                       asp-action="Login">
                                        Login
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="btn btn-primary ms-lg-2"
                                       asp-controller="Account"
                                       asp-action="Register">
                                        Register
                                    </a>
                                </li>
                            }
                            else
                            {
                                <li class="nav-item">
                                    <form asp-controller="Account"
                                          asp-action="Logout"
                                          method="post">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="btn btn-outline-light ms-lg-2">
                                            Logout
                                        </button>
                                    </form>
                                </li>
                            }

                        </ul>

                    </div>
                </div>
            </nav>
        </header>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - RaceDayMVC - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
