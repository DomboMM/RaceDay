@model List<RaceDayMVC.Models.EnrolmentViewModel>

@{
    ViewData["Title"] = "My Events";
}

<div class="container mt-4">

    <h2 class="fw-bold mb-3">My Events</h2>

    <p class="text-muted">
        View the RaceDay events you have enrolled in.
    </p>

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger">
            @ViewBag.ErrorMessage
        </div>
    }

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">
            You have not enrolled in any events yet.
        </div>

        <a asp-controller="Events"
           asp-action="Index"
           class="btn btn-primary">
            Browse Events
        </a>
    }
    else
    {
        <div class="row g-4">

            @foreach (var enrolment in Model)
            {
                <div class="col-md-6 col-lg-4">

                    <div class="card h-100 shadow-sm border-0">
                        <div class="card-body">

                            <h5 class="card-title fw-bold">
                                @(enrolment.Event?.Name ?? "Event Unavailable")
                            </h5>

                            <p class="mb-2">
                                <strong>Category:</strong>
                                @(enrolment.Category?.CategoryName ?? "N/A")
                            </p>

                            <p class="mb-2">
                                <strong>Event Date:</strong>
                                @(enrolment.Event?.EventDate.ToString("dd MMMM yyyy") ?? "N/A")
                            </p>

                            <p class="mb-2">
                                <strong>Location:</strong>
                                @(enrolment.Event?.Location ?? "N/A")
                            </p>

                            <p class="mb-2">
                                <strong>Distance:</strong>
                                @(enrolment.Event?.Distance.ToString() ?? "N/A") km
                            </p>

                            <p class="mb-3">
                                <strong>Enrolled On:</strong>
                                @enrolment.EnrolmentDate.ToString("dd MMMM yyyy")
                            </p>

                            <span class="badge bg-success">
                                Enrolled
                            </span>

                        </div>
                    </div>

                </div>
            }

        </div>
    }

</div>
