@model List<RaceDayMVC.Models.ResultViewModel>

@{
    ViewData["Title"] = "My Results";
}

<div class="container mt-4">

    <h2 class="fw-bold mb-3">My Results</h2>

    <p class="text-muted">
        View your finishing times and positions
        for completed RaceDay events.
    </p>

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger">
            @ViewBag.ErrorMessage
        </div>
    }

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">
            No race results are available yet.
            Your results will appear here after
            an Organiser records them.
        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table table-striped table-hover">

                <thead class="table-dark">
                    <tr>
                        <th>Result ID</th>
                        <th>Enrolment ID</th>
                        <th>Finish Time</th>
                        <th>Finishing Position</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var result in Model)
                    {
                        <tr>
                            <td>@result.ResultID</td>

                            <td>@result.EnrolmentID</td>

                            <td>
                                @result.FinishTime.ToString(@"hh\:mm\:ss")
                            </td>

                            <td>@result.FinishingPosition</td>
                        </tr>
                    }
                </tbody>

            </table>

        </div>
    }

    <a asp-controller="Participant"
       asp-action="MyEvents"
       class="btn btn-secondary mt-3">
        Back to My Events
    </a>

</div>
