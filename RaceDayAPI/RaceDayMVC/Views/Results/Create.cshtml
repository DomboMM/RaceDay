@model RaceDayMVC.Models.CreateResultViewModel

@{
    ViewData["Title"] = "Record Race Result";
}

<div class="container mt-4">

    <h2 class="fw-bold mb-3">Record Race Result</h2>

    <p class="text-muted">
        Enter the finishing time and position
        for the selected participant enrolment.
    </p>

    <div class="card shadow-sm">
        <div class="card-body">

            <form asp-controller="Results"
                  asp-action="Create"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <input asp-for="EnrolmentID"
                       type="hidden" />

                <div class="mb-3">
                    <label class="form-label">
                        Enrolment ID
                    </label>

                    <input value="@Model.EnrolmentID"
                           class="form-control"
                           readonly />
                </div>

                <div class="mb-3">
                    <label asp-for="FinishTime"
                           class="form-label">
                        Finishing Time (HH:MM:SS)
                    </label>

                    <input asp-for="FinishTime"
                           type="text"
                           class="form-control"
                           placeholder="00:35:20"
                           required />

                    <span asp-validation-for="FinishTime"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="FinishingPosition"
                           class="form-label">
                        Finishing Position
                    </label>

                    <input asp-for="FinishingPosition"
                           type="number"
                           min="1"
                           class="form-control"
                           placeholder="1"
                           required />

                    <span asp-validation-for="FinishingPosition"
                          class="text-danger"></span>
                </div>

                <button type="submit"
                        class="btn btn-primary">
                    Save Result
                </button>

                <a asp-controller="Results"
                   asp-action="Index"
                   class="btn btn-secondary">
                    Cancel
                </a>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
