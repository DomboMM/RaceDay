@model List<RaceDayMVC.Models.CategoryViewModel>

@{
    ViewData["Title"] = "Manage Categories";
}

<div class="container mt-4">

    <h2 class="fw-bold mb-3">Manage Categories</h2>

    <a asp-controller="Categories"
       asp-action="Create"
       class="btn btn-primary mb-3">
        + Create Category
    </a>


    <p class="text-muted">
        View and manage categories for your RaceDay events.
    </p>

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger">
            @ViewBag.ErrorMessage
        </div>
    }

    <div class="card shadow-sm border-0 mt-4">
        <div class="card-body">

            <h4 class="mb-3">My Categories</h4>

            @if (Model.Count == 0)
            {
                <div class="alert alert-info">
                    No categories found for your events.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">

                        <thead class="table-dark">
                            <tr>
                                <th>Category ID</th>
                                <th>Event ID</th>
                                <th>Category Name</th>
                                <th>Category Type</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var category in Model)
                            {
                                <tr>
                                    <td>@category.CategoryID</td>
                                    <td>@category.EventID</td>
                                    <td>@category.CategoryName</td>
                                    <td>@category.CategoryType</td>
                                </tr>
                            }
                        </tbody>

                    </table>
                </div>
            }

        </div>
    </div>

</div>
