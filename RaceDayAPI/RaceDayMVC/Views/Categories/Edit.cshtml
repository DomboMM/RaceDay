@model RaceDayMVC.Models.CategoryViewModel

@{
    ViewData["Title"] = "Edit Category";
}

<div class="container mt-4">
    <h2 class="fw-bold mb-3">Edit Category</h2>

    <p class="text-muted">
        Update the details of your RaceDay event category.
    </p>

    <div class="card shadow-sm border-0">
        <div class="card-body">

            <form asp-controller="Categories"
                  asp-action="Edit"
                  asp-route-id="@Model.CategoryID"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="CategoryID" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="EventID"
                           class="form-label">
                        Select Event
                    </label>

                    <select asp-for="EventID"
                            asp-items="ViewBag.Events"
                            class="form-select">
                        <option value="0">-- Select an Event --</option>
                    </select>

                    <span asp-validation-for="EventID"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="CategoryName"
                           class="form-label">
                        Category Name
                    </label>

                    <input asp-for="CategoryName"
                           class="form-control" />

                    <span asp-validation-for="CategoryName"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="CategoryType"
                           class="form-label">
                        Category Type
                    </label>

                    <input asp-for="CategoryType"
                           class="form-control" />

                    <span asp-validation-for="CategoryType"
                          class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary">
                    Save Changes
                </button>

                <a asp-controller="Categories"
                   asp-action="Index"
                   class="btn btn-secondary ms-2">
                    Cancel
                </a>

            </form>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
