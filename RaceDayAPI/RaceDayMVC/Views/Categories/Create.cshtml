@model RaceDayMVC.Models.CreateCategoryViewModel

@{
    ViewData["Title"] = "Create Category";
}

<div class="container mt-4">
    <h2 class="fw-bold mb-3">Create Category</h2>

    <p class="text-muted">
        Add a new category to one of your RaceDay events.
    </p>

    <div class="card shadow-sm border-0">
        <div class="card-body">

            <form asp-controller="Categories"
                  asp-action="Create"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="EventID"
                           class="form-label">
                        Select Event
                    </label>

                    <select asp-for="EventID"
                            asp-items="ViewBag.Events"
                            class="form-select">
                        <option value="0">
                            -- Select an Event --
                        </option>
                    </select>

                    <span asp-validation-for="EventID"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="CategoryName"
                           class="form-label">
                        Category Name
                    </label>

                    <input asp-for="CategoryName"
                           class="form-control"
                           placeholder="e.g. 5 km Fun Run" />

                    <span asp-validation-for="CategoryName"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="CategoryType"
                           class="form-label">
                        Category Type
                    </label>

                    <input asp-for="CategoryType"
                           class="form-control"
                           placeholder="e.g. Running" />

                    <span asp-validation-for="CategoryType"
                          class="text-danger"></span>
                </div>

                <button type="submit"
                        class="btn btn-primary">
                    Create Category
                </button>

                <a asp-controller="Categories"
                   asp-action="Index"
                   class="btn btn-secondary ms-2">
                    Cancel
                </a>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
