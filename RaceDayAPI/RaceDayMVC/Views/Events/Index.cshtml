@model List<RaceDayMVC.Models.EventViewModel>

@{
    ViewData["Title"] = "Browse Events";
}

<div class="container mt-4">

    <h2 class="fw-bold mb-3">Browse Events</h2>

    <p class="text-muted">
        Discover upcoming RaceDay events and find a race
        you would like to join.
    </p>

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger">
            @ViewBag.ErrorMessage
        </div>
    }

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">
            No upcoming events are available at the moment.
        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var raceEvent in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm border-0">

                        <div class="card-body">

                            <h5 class="card-title fw-bold">
                                @raceEvent.Name
                            </h5>

                            <p class="card-text text-muted">
                                @raceEvent.Description
                            </p>

                            <p class="mb-2">
                                <strong>Date:</strong>
                                @raceEvent.EventDate.ToString("dd MMMM yyyy")
                            </p>

                            <p class="mb-2">
                                <strong>Location:</strong>
                                @raceEvent.Location
                            </p>

                            <p class="mb-3">
                                <strong>Distance:</strong>
                                @raceEvent.Distance km
                            </p>

                            <a asp-controller="Enrolments"
                               asp-action="Create"
                               asp-route-eventId="@raceEvent.EventID"
                               class="btn btn-primary">
                                Enrol Now
                            </a>

                        </div>
                    </div>
                </div>
            }

        </div>
    }

</div>
